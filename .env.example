# Anthropic API Key for content generation
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Custyle blog content directory (path to Nuxt.js content/blog folder)
BLOG_CONTENT_DIR=../custyle-website/content/blog

# Generation settings
DEFAULT_LANGUAGE=en
DEFAULT_MODEL=claude-sonnet-4-20250514
MAX_TOKENS=8192

# Publishing
AUTO_PUBLISH=false
GIT_AUTO_COMMIT=false
GIT_REMOTE_REPO=

# Schedule (cron expression - default: every day at 9am)
CRON_SCHEDULE=0 9 * * *
